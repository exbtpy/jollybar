# Rename the app here, then update the matching values in
# macos/Sources/Jollybar/AppIdentity.swift (a unit test checks they match).
# APP_PRODUCT_NAME and APP_EXECUTABLE_NAME must also match the SwiftPM executable
# target in macos/Package.swift, including Sources/<target>/.
# CONFIG_DIR_NAME is the ~/.config directory, the Homebrew cask token, and the
# value sent as x-grok-client-version.
APP_PRODUCT_NAME=Jollybar
APP_EXECUTABLE_NAME=Jollybar
APP_DISPLAY_NAME=Jollybar
APP_MENU_TITLE=Jollybar
APP_BUNDLE_ID=com.exbtpy.Jollybar
DMG_NAME=Jollybar
CONFIG_DIR_NAME=jollybar
