# Rename the app here, then update the matching values in
# macos/Sources/GrokUsageBar/AppIdentity.swift (a unit test checks they match).
# APP_PRODUCT_NAME and APP_EXECUTABLE_NAME must also match the SwiftPM executable
# target in macos/Package.swift, including Sources/<target>/, until that target
# is renamed. CONFIG_DIR_NAME is the ~/.config directory and the Homebrew cask token.
APP_PRODUCT_NAME=GrokUsageBar
APP_EXECUTABLE_NAME=GrokUsageBar
APP_DISPLAY_NAME='Grok Usage Bar'
APP_MENU_TITLE='Grok Usage'
APP_BUNDLE_ID=com.exbtpy.GrokUsageBar
DMG_NAME=GrokUsageBar
CONFIG_DIR_NAME=grok-usage-bar
